# 管理页面对外端口
WEB_PORT=8080

# 请使用足够长的随机字符串。首次运行“一键启动.bat”时会自动生成。
JWT_SECRET=

# 用于加密“记住登录”长会话凭据的密钥。
# 必须是 32 字节的随机值经过 Base64 编码。留空时首次启动会自动生成并保存到 data/session.key。
# 可生成一个：node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_ENCRYPTION_KEY=

# HTTPS 部署保持 true。仅在可信局域网内直接使用 http://IP:端口 时设为 false。
SESSION_COOKIE_SECURE=true

# 允许连接的 TeamSpeak 服务器，多个地址使用英文逗号分隔。
# 留空表示不限制，不建议在公网环境留空。
WHITELIST=

# 会话有效期（毫秒）。
# 普通会话：绝对 8 小时；空闲 8 小时。
# 记住登录：绝对 30 天；空闲 30 天。
# SESSION_TEMP_TTL_MS=28800000
# SESSION_TEMP_IDLE_TTL_MS=28800000
# SESSION_REMEMBER_TTL_MS=2592000000
# SESSION_REMEMBER_IDLE_TTL_MS=2592000000

# 记住登录的会话读取时是否写盘节流。默认 10 分钟（毫秒）。
# SESSION_PERSIST_THROTTLE_MS=600000

# 单个账号允许的最大并发会话数。
# SESSION_MAX_ACTIVE_PER_ACCOUNT=50

# 登录限流：单个 IP 每 60 秒最多允许的登录尝试次数。
# SESSION_LOGIN_RATE_WINDOW_MS=60000
# SESSION_LOGIN_RATE_MAX=5

# Socket.IO 连接限流与同一会话最大连接数。
# SOCKET_RATE_LIMIT_WINDOW_MS=60000
# SOCKET_RATE_LIMIT_MAX=10
# SOCKET_SESSION_MAX_CONNECTIONS=3

# 文件传输票据有效期（毫秒），默认 45 秒。
# FILE_TRANSFER_TICKET_TTL_MS=45000

# 单文件大小上限（字节，0 表示不限制）。
# FILE_TRANSFER_MAX_SIZE=0
# 单会话与全局并发传输数。
# FILE_TRANSFER_SESSION_CONCURRENCY=2
# FILE_TRANSFER_GLOBAL_CONCURRENCY=20
# TCP 建连超时与空闲超时（毫秒）。
# FILE_TRANSFER_CONNECT_TIMEOUT_MS=5000
# FILE_TRANSFER_IDLE_TIMEOUT_MS=30000

# 仅在管理服务确实运行于反向代理（Nginx/Caddy/Docker）之后时设为 1，否则保持关闭，
# 以避免直接暴露的端口被伪造的 X-Forwarded-* 头欺骗。
# TRUST_PROXY=1

# 生产环境允许的跨域来源（用于对状态变更接口做 Origin/CSRF 校验）。多个来源用英文逗号分隔。
# ALLOWED_ORIGINS=https://ts3.example.com
