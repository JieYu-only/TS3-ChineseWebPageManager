# 管理页面对外端口
WEB_PORT=8080

# 请使用足够长的随机字符串。首次运行“一键启动.bat”时会自动生成。
JWT_SECRET=

# 用于加密“记住登录”长会话凭据的密钥。
# 必须是 32 字节的随机值经过 Base64 编码。留空时首次启动会自动生成并保存到 data/session.key。
# 可生成一个：node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_ENCRYPTION_KEY=

# 允许连接的 TeamSpeak 服务器，多个地址使用英文逗号分隔。
# 留空表示不限制，不建议在公网环境留空。
WHITELIST=
