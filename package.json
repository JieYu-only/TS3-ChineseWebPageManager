{
  "name": "ts3-manager",
  "version": "v4.0.0",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "concurrently --kill-others --names \"UI,SERVER\" -c \"bgGreen.black,bgMagenta.black\" \"npm run serve --workspace=@ts3-manager/ui\" \"npm run dev --workspace=@ts3-manager/server\"",
    "build": "npm run build --workspace=@ts3-manager/ui --workspace=@ts3-manager/server",
    "server:start": "npm run start --workspace=@ts3-manager/server",
    "server:dev": "npm run dev --workspace=@ts3-manager/server",
    "server:build": "npm run build --workspace=@ts3-manager/server",
    "server:test": "npm run test --workspace=@ts3-manager/server",
    "check:decoupling": "node scripts/check-decoupling.js",
    "test:ui:e2e": "npm run ui:build && node scripts/run-ui-e2e.js",
    "test:ui:persist": "npm run test:persist --workspace=@ts3-manager/ui",
    "test:ui:e2e:headed": "npm run ui:build && node scripts/run-ui-e2e.js --headed",
    "ui:build": "npm run build --workspace=@ts3-manager/ui",
    "ui:serve": "npm run serve --workspace=@ts3-manager/ui",
    "ui:clean": "node -e \"require('fs').rmSync('packages/ui/dist', { recursive: true, force: true })\"",
    "ui:rebuild": "npm run ui:clean && npm run ui:build",
    "test": "npm run test --workspace=@ts3-manager/server"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "concurrently": "^6.2.0"
  },
  "overrides": {
    "@vue/compiler-sfc": {
      "postcss": "^8.5.26"
    },
    "vue": "^3.5.42",
    "local-echo": {
      "shell-quote": "^1.10.0"
    },
    "socket.io-adapter": "^2.5.8",
    "socket.io-parser": "^4.2.7"
  }
}
